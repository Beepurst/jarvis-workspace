# ============================================================
# TEMPLATE DE VARIABLES D'ENVIRONNEMENT
# ============================================================
#
# Copie ce fichier en .env et remplis les valeurs.
# cp .env.example .env
# ============================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notion ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# --- n8n ---
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --- Make (Integromat) ---
MAKE_API_KEY=

# --- Base de données ---
DATABASE_URL=

# --- GitHub ---
GITHUB_TOKEN=

# --- Divers ---
APP_SECRET=

# Hub Agence : commande /demain (même valeur que TODO_AGENT_SECRET du hub)
HUB_URL=https://hub-agence-kleak.vercel.app
TODO_AGENT_SECRET=

# Hub Agence : agent media-buyer (même valeur que ADS_AGENT_SECRET du hub)
ADS_AGENT_SECRET=

# Hub Agence : agent bibliothecaire (même valeur que BIBLIO_AGENT_SECRET du hub)
BIBLIO_AGENT_SECRET=

# Hub Agence : brief de production (même valeur que BRIEF_AGENT_SECRET du hub)
BRIEF_AGENT_SECRET=
